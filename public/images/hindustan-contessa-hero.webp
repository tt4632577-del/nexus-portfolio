<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 900" width="1600" height="900">
  <defs>
    <radialGradient id="bgGlow" cx="65%" cy="50%" r="55%">
      <stop offset="0%" stop-color="#D71920" stop-opacity="0.16" />
      <stop offset="50%" stop-color="#141414" stop-opacity="0.8" />
      <stop offset="100%" stop-color="#080808" stop-opacity="1" />
    </radialGradient>
    <linearGradient id="horizonGlow" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#080808" />
      <stop offset="30%" stop-color="#292929" />
      <stop offset="65%" stop-color="#D71920" stop-opacity="0.8" />
      <stop offset="100%" stop-color="#080808" />
    </linearGradient>
    <linearGradient id="accentBeam" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#D71920" stop-opacity="0.4" />
      <stop offset="100%" stop-color="#D71920" stop-opacity="0" />
    </linearGradient>
  </defs>

  <!-- Deep Charcoal / Black Backdrop -->
  <rect width="1600" height="900" fill="#080808" />
  <rect width="1600" height="900" fill="url(#bgGlow)" />

  <!-- Studio Floor Grid & Reflection Horizon -->
  <line x1="100" y1="620" x2="1500" y2="620" stroke="url(#horizonGlow)" stroke-width="2" />
  <line x1="200" y1="680" x2="1400" y2="680" stroke="#1f1f1f" stroke-width="1" />
  <line x1="300" y1="740" x2="1300" y2="740" stroke="#141414" stroke-width="1" />

  <!-- Stylized Automotive Silhouette Frame (Contessa Long Bonnet & Notchback Roofline) -->
  <g opacity="0.85" transform="translate(100, 30)">
    <!-- Chassis Floor Shadow -->
    <ellipse cx="850" cy="590" rx="460" ry="26" fill="#000000" opacity="0.9" />

    <!-- Sleek Long-Wheelbase Profile Line -->
    <path d="M 420 540 C 440 500, 480 475, 540 470 L 680 465 L 770 380 L 1050 375 L 1170 460 L 1280 475 C 1310 480, 1330 510, 1320 540 Z" fill="#111111" stroke="#2e2e2e" stroke-width="2" />
    
    <!-- Roof & Pillar Line -->
    <path d="M 680 465 L 770 380 L 1050 375 L 1170 460 Z" fill="#161616" stroke="#D71920" stroke-width="1.5" stroke-opacity="0.6" />

    <!-- Distinctive Dual Headlamp & Rectangular Chrome Grille Highlight -->
    <rect x="425" y="485" width="22" height="38" rx="4" fill="#D71920" opacity="0.8" />
    <circle cx="436" cy="496" r="6" fill="#FFFFFF" opacity="0.9" />
    <circle cx="436" cy="512" r="6" fill="#FF343B" opacity="0.9" />

    <!-- Front & Rear Wheels -->
    <circle cx="580" cy="545" r="46" fill="#080808" stroke="#333333" stroke-width="6" />
    <circle cx="580" cy="545" r="22" fill="#181818" stroke="#D71920" stroke-width="2" />
    
    <circle cx="1140" cy="545" r="46" fill="#080808" stroke="#333333" stroke-width="6" />
    <circle cx="1140" cy="545" r="22" fill="#181818" stroke="#D71920" stroke-width="2" />

    <!-- Chrome Beltline Accent -->
    <path d="M 450 495 L 1300 495" stroke="#444444" stroke-width="1.5" />
    <path d="M 450 497 L 1300 497" stroke="#D71920" stroke-width="1" stroke-opacity="0.5" />
  </g>

  <!-- Editorial Metadata Overlay -->
  <g font-family="'Space Grotesk', -apple-system, sans-serif" fill="#F5F5F5">
    <text x="80" y="120" font-size="14" font-family="'JetBrains Mono', monospace" fill="#D71920" letter-spacing="4" font-weight="600">
      // AUTOMOTIVE EDITORIAL ASSET
    </text>
    <text x="80" y="160" font-size="32" font-weight="800" letter-spacing="2">
      HINDUSTAN CONTESSA
    </text>
    <text x="80" y="195" font-size="14" fill="#A3A3A3" letter-spacing="1">
      CLASSIC INDIAN LUXURY SEDAN • VAUXHALL VICTOR FE HERITAGE
    </text>
  </g>

  <!-- Clear Asset Notification Badge -->
  <g transform="translate(80, 780)" font-family="'JetBrains Mono', monospace">
    <rect width="640" height="52" rx="8" fill="#111111" stroke="#292929" stroke-width="1" />
    <circle cx="28" cy="26" r="6" fill="#D71920" />
    <text x="46" y="24" font-size="12" fill="#F5F5F5" font-weight="600">
      ASSET LOCATION: public/images/hindustan-contessa-hero.webp
    </text>
    <text x="46" y="42" font-size="11" fill="#707070">
      Drop your authentic dark-colored Contessa photograph here to replace
    </text>
  </g>
</svg>
